#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILLS_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"
RUNTIME_DIR="${YTDLP_RUNTIME_DIR:-$SKILLS_DIR/.runtime/yt-dlp}"

if ! command -v python3 >/dev/null 2>&1; then
  echo "Python 3.10+ is required to install yt-dlp." >&2
  exit 1
fi

python3 -m venv "$RUNTIME_DIR"
"$RUNTIME_DIR/bin/python" -m pip install -U --pre 'yt-dlp[default]'
"$RUNTIME_DIR/bin/yt-dlp" --version
